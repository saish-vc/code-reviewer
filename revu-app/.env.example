# REVU Desktop App — Environment Variables

# Production backend URL — required for API calls from the Tauri desktop app.
# Replace with your actual deployed backend URL (e.g. Render, Railway, etc.)
VITE_API_BASE_URL=https://your-production-backend.onrender.com

# For local development against the local Python backend:
# VITE_API_BASE_URL=http://localhost:7860
