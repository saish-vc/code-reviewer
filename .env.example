NVIDIA_API_KEY=your_nvidia_api_key_here

# CORS — comma-separated list of allowed request origins.
#
# Tauri webview origins (platform-specific — both must be included):
#   Windows:        http://tauri.localhost
#   macOS & Linux:  tauri://localhost
#
# Local development origins (Vite dev server at port 5173, backend at 7860):
#   http://localhost:5173
#   http://127.0.0.1:5173
#   http://localhost:7860
#   http://127.0.0.1:7860
#
# The hosted web version of revu-app has been retired. Do NOT add a public
# app URL here. No wildcard (*) — keep this list explicit.
ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:7860,http://127.0.0.1:7860
